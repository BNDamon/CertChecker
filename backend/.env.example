# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Postgres connection string (Project Settings -> Database -> Connection string -> URI)
# Use the "connection pooling" URI in production; direct URI is fine for local dev.
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Resend (resend.com -> API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxx

# Free tier limit
FREE_TIER_DOMAIN_LIMIT=3

# Daily check schedule (cron syntax, server local time). Default: 06:00 every day.
CHECK_CRON_SCHEDULE=0 6 * * *
